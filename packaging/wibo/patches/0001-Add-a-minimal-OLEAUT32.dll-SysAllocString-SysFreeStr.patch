From 641aac7ba8a91c7aa0c5e45ac22a741064d3d19d Mon Sep 17 00:00:00 2001
From: Nick Silvestro <nick@silvestron.com>
Date: Sun, 18 Oct 2026 15:12:48 +1100
Subject: [PATCH 1/4] Add a minimal OLEAUT32.dll (SysAllocString,
 SysFreeString, GetErrorInfo)

The Xbox XDK 5849 Link.Exe delay-loads OLEAUT32.dll ordinals 2, 6 and 200 on /LTCG links. Without the module the delay-load helper raises an exception (rc 126). Ordinal 200 is GetErrorInfo; it reports no error object.
---
 dll/oleaut32.cpp | 84 ++++++++++++++++++++++++++++++++++++++++++++++++
 dll/oleaut32.h   | 11 +++++++
 src/modules.cpp  |  3 +-
 3 files changed, 97 insertions(+), 1 deletion(-)
 create mode 100644 dll/oleaut32.cpp
 create mode 100644 dll/oleaut32.h

diff --git a/dll/oleaut32.cpp b/dll/oleaut32.cpp
new file mode 100644
index 0000000..409fc34
--- /dev/null
+++ b/dll/oleaut32.cpp
@@ -0,0 +1,84 @@
+#include "oleaut32.h"
+
+#include "common.h"
+#include "context.h"
+#include "heap.h"
+#include "modules.h"
+#include "strutil.h"
+
+#include <cstring>
+
+namespace {
+
+constexpr HRESULT S_FALSE = 1;
+
+} // namespace
+
+namespace oleaut32 {
+
+// A BSTR is a pointer to UTF-16 data that is preceded by a 32-bit byte length and followed by a NUL terminator.
+LPWSTR WINAPI SysAllocString(LPCWSTR psz) {
+	HOST_CONTEXT_GUARD();
+	DEBUG_LOG("SysAllocString(%p)\n", psz);
+	if (!psz) {
+		return nullptr;
+	}
+	size_t length = wstrlen(psz);
+	size_t bytes = length * sizeof(WCHAR);
+	auto *block = static_cast<uint8_t *>(wibo::heap::guestMalloc(sizeof(uint32_t) + bytes + sizeof(WCHAR)));
+	if (!block) {
+		return nullptr;
+	}
+	*reinterpret_cast<uint32_t *>(block) = static_cast<uint32_t>(bytes);
+	auto *data = reinterpret_cast<LPWSTR>(block + sizeof(uint32_t));
+	std::memcpy(data, psz, bytes);
+	data[length] = 0;
+	return data;
+}
+
+void WINAPI SysFreeString(LPWSTR bstrString) {
+	HOST_CONTEXT_GUARD();
+	DEBUG_LOG("SysFreeString(%p)\n", bstrString);
+	if (!bstrString) {
+		return;
+	}
+	wibo::heap::guestFree(reinterpret_cast<uint8_t *>(bstrString) - sizeof(uint32_t));
+}
+
+// Ordinal 200. The Microsoft linker only calls this on its COM error-reporting paths (managed/CLR images); there is
+// never an error object to hand back, so report S_FALSE ("no error information") with a null interface pointer.
+HRESULT WINAPI GetErrorInfo(DWORD dwReserved, GUEST_PTR *pperrinfo) {
+	HOST_CONTEXT_GUARD();
+	DEBUG_LOG("GetErrorInfo(%u, %p)\n", dwReserved, pperrinfo);
+	(void)dwReserved;
+	if (pperrinfo) {
+		*pperrinfo = GUEST_NULL;
+	}
+	return S_FALSE;
+}
+
+} // namespace oleaut32
+
+#include "oleaut32_trampolines.h"
+
+static void *resolveByOrdinal(uint16_t ordinal) {
+	// OLEAUT32.dll export ordinals, as imported by the Microsoft linker (Link.Exe 7.10).
+	switch (ordinal) {
+	case 2:
+		return (void *)thunk_oleaut32_SysAllocString;
+	case 6:
+		return (void *)thunk_oleaut32_SysFreeString;
+	case 200:
+		return (void *)thunk_oleaut32_GetErrorInfo;
+	}
+	return nullptr;
+}
+
+extern const wibo::ModuleStub lib_oleaut32 = {
+	(const char *[]){
+		"oleaut32",
+		nullptr,
+	},
+	oleaut32ThunkByName,
+	resolveByOrdinal,
+};
diff --git a/dll/oleaut32.h b/dll/oleaut32.h
new file mode 100644
index 0000000..1187e5d
--- /dev/null
+++ b/dll/oleaut32.h
@@ -0,0 +1,11 @@
+#pragma once
+
+#include "types.h"
+
+namespace oleaut32 {
+
+LPWSTR WINAPI SysAllocString(LPCWSTR psz);
+void WINAPI SysFreeString(LPWSTR bstrString);
+HRESULT WINAPI GetErrorInfo(DWORD dwReserved, GUEST_PTR *pperrinfo);
+
+} // namespace oleaut32
diff --git a/src/modules.cpp b/src/modules.cpp
index a699e42..1843749 100644
--- a/src/modules.cpp
+++ b/src/modules.cpp
@@ -62,6 +62,7 @@ extern const wibo::ModuleStub lib_ucrtbase;
 extern const wibo::ModuleStub lib_ntdll;
 extern const wibo::ModuleStub lib_rpcrt4;
 extern const wibo::ModuleStub lib_ole32;
+extern const wibo::ModuleStub lib_oleaut32;
 extern const wibo::ModuleStub lib_shlwapi;
 extern const wibo::ModuleStub lib_user32;
 extern const wibo::ModuleStub lib_vcruntime;
@@ -268,7 +269,7 @@ LockedRegistry registry() {
 		reg.initialized = true;
 		const wibo::ModuleStub *builtins[] = {
 			&lib_advapi32, &lib_bcrypt, &lib_kernel32, &lib_lmgr,	   &lib_mscoree, &lib_ntdll,
-			&lib_ole32,	   &lib_rpcrt4, &lib_shlwapi, &lib_user32,	   &lib_vcruntime, &lib_version,
+			&lib_ole32,	   &lib_oleaut32, &lib_rpcrt4, &lib_shlwapi, &lib_user32,	   &lib_vcruntime, &lib_version,
 			&lib_ws2,
 #if WIBO_HAS_MSVCRT
 			&lib_msvcrt,
