+LPSTR WINAPI CharNextA(LPCSTR lpsz) {
+	HOST_CONTEXT_GUARD();
+	VERBOSE_LOG("CharNextA(%p)\n", lpsz);
+	// Single-byte code page only: no lead bytes to skip.
+	if (!lpsz) {
+		return nullptr;
+	}
+	return const_cast<LPSTR>(*lpsz ? lpsz + 1 : lpsz);
+}
+
