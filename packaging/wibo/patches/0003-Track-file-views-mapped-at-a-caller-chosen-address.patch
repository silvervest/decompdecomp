From 71551351702345039db47f25c81e2ffef8b76119 Mon Sep 17 00:00:00 2001
From: Nick Silvestro <nick@silvestron.com>
Date: Sun, 18 Oct 2026 15:20:45 +1100
Subject: [PATCH 3/4] Track file views mapped at a caller-chosen address

MapViewOfFileEx with a base address used MAP_FIXED_NOREPLACE, which always failed over the PROT_NONE placeholder that VirtualFree leaves behind, and never recorded the view, so VirtualAlloc could later return an address inside it. Link.Exe probes for free space with VirtualAlloc/VirtualFree and then maps each library at that address; with a 22 MB library (d3d8ltcg.lib) the second probe landed inside the first view and the link failed with LNK1104 on TEMPFILE.
---
 dll/kernel32/memoryapi.cpp | 15 +++++++++++----
 src/heap.cpp               | 23 +++++++++++++++++++++++
 src/heap.h                 |  1 +
 3 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/dll/kernel32/memoryapi.cpp b/dll/kernel32/memoryapi.cpp
index b43badd..315fac3 100644
--- a/dll/kernel32/memoryapi.cpp
+++ b/dll/kernel32/memoryapi.cpp
@@ -393,11 +393,18 @@ static LPVOID mapViewOfFileInternal(Pin<MappingObject> mapping, DWORD dwDesiredA
 			return nullptr;
 		}
 		requestedBase = reinterpret_cast<void *>(mapBaseAddr);
-#ifdef MAP_FIXED_NOREPLACE
-		mapFlags |= MAP_FIXED_NOREPLACE;
-#else
+		// Track the range, like the non-fixed case below. The requested range is typically one the caller just
+		// released with VirtualFree (Link.Exe probes for free space that way), which wibo leaves mapped as a
+		// PROT_NONE placeholder: the claim fails if the guest still has something there, so MAP_FIXED is safe.
+		wibo::heap::VmStatus claimStatus = wibo::heap::reserveViewRangeAt(requestedBase, mapLength);
+		if (claimStatus != wibo::heap::VmStatus::Success) {
+			setLastError(claimStatus == wibo::heap::VmStatus::InvalidParameter
+							 ? ERROR_INVALID_PARAMETER
+							 : ERROR_INVALID_ADDRESS);
+			return nullptr;
+		}
+		reservedMapping = true;
 		mapFlags |= MAP_FIXED;
-#endif
 	} else {
 		void *candidate = nullptr;
 		wibo::heap::VmStatus reserveStatus = wibo::heap::reserveViewRange(mapLength, 0, 0, &candidate);
diff --git a/src/heap.cpp b/src/heap.cpp
index 76687c6..07f47fe 100644
--- a/src/heap.cpp
+++ b/src/heap.cpp
@@ -1203,6 +1203,29 @@ VmStatus reserveViewRange(std::size_t regionSize, uintptr_t minAddr, uintptr_t m
 	return VmStatus::Success;
 }
 
+// Claims a caller-chosen address range for a file view. Released VirtualAlloc ranges stay mapped as PROT_NONE
+// placeholders, so the caller must map over them with MAP_FIXED once this succeeds.
+VmStatus reserveViewRangeAt(void *baseAddress, std::size_t regionSize) {
+	if (!baseAddress || regionSize == 0) {
+		return VmStatus::InvalidParameter;
+	}
+	const uintptr_t pageSize = wibo::heap::systemPageSize();
+	const uintptr_t base = reinterpret_cast<uintptr_t>(baseAddress);
+	const std::size_t aligned = static_cast<std::size_t>(alignUp(static_cast<uintptr_t>(regionSize), pageSize));
+	if (aligned == 0 || addOverflows(base, aligned)) {
+		return VmStatus::InvalidParameter;
+	}
+	if (base >= kTwoGB || (base + aligned) > kTwoGB) {
+		return VmStatus::InvalidAddress;
+	}
+	std::lock_guard allocLock(g_mappingsMutex);
+	if (overlapsExistingMappingLocked(base, aligned)) {
+		return VmStatus::InvalidAddress;
+	}
+	recordGuestMappingLocked(base, aligned, PAGE_NOACCESS, MEM_RESERVE, PAGE_NOACCESS, MEM_MAPPED);
+	return VmStatus::Success;
+}
+
 void registerViewRange(void *baseAddress, std::size_t regionSize, DWORD allocationProtect, DWORD protect) {
 	if (!baseAddress) {
 		return;
diff --git a/src/heap.h b/src/heap.h
index d1fb8a2..244bef4 100644
--- a/src/heap.h
+++ b/src/heap.h
@@ -80,6 +80,7 @@ VmStatus virtualQuery(const void *address, MEMORY_BASIC_INFORMATION *outInfo);
 VmStatus virtualReset(void *baseAddress, std::size_t regionSize);
 
 VmStatus reserveViewRange(std::size_t regionSize, uintptr_t minAddr, uintptr_t maxAddr, void **baseAddress);
+VmStatus reserveViewRangeAt(void *baseAddress, std::size_t regionSize);
 void registerViewRange(void *baseAddress, std::size_t regionSize, DWORD allocationProtect, DWORD protect);
 void releaseViewRange(void *baseAddress);
 
