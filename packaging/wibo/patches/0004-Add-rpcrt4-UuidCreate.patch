From ddf463420529b2d6a0c414b1d862cea6dbe2bf8f Mon Sep 17 00:00:00 2001
From: Nick Silvestro <nick@silvestron.com>
Date: Sun, 18 Oct 2026 15:26:01 +1100
Subject: [PATCH 4/4] Add rpcrt4 UuidCreate

mspdb71.dll calls it to sign a PDB, so cl /Zi and link /DEBUG aborted on the missing import. Returns a random version-4 GUID.
---
 dll/rpcrt4.cpp | 20 ++++++++++++++++++++
 dll/rpcrt4.h   |  1 +
 2 files changed, 21 insertions(+)

diff --git a/dll/rpcrt4.cpp b/dll/rpcrt4.cpp
index b147aea..70f8cba 100644
--- a/dll/rpcrt4.cpp
+++ b/dll/rpcrt4.cpp
@@ -9,6 +9,7 @@
 #include <cstdlib>
 #include <cstring>
 #include <memory>
+#include <random>
 #include <string>
 #include <unordered_map>
 
@@ -240,6 +241,25 @@ VOID WINAPI NdrServerCall2(PRPC_MESSAGE message) {
 	DEBUG_LOG("STUB: NdrServerCall2 message=%p\n", message);
 }
 
+RPC_STATUS WINAPI UuidCreate(GUID *uuid) {
+	HOST_CONTEXT_GUARD();
+	DEBUG_LOG("UuidCreate(%p)\n", uuid);
+	if (!uuid) {
+		return RPC_S_INVALID_ARG;
+	}
+	// Random (version 4, RFC 4122 variant) GUID.
+	std::random_device rd;
+	uint8_t bytes[sizeof(GUID)];
+	for (size_t i = 0; i < sizeof(bytes); i += sizeof(uint32_t)) {
+		uint32_t word = rd();
+		std::memcpy(bytes + i, &word, sizeof(word));
+	}
+	std::memcpy(uuid, bytes, sizeof(GUID));
+	uuid->Data3 = static_cast<WORD>((uuid->Data3 & 0x0FFF) | 0x4000);
+	uuid->Data4[0] = static_cast<BYTE>((uuid->Data4[0] & 0x3F) | 0x80);
+	return RPC_S_OK;
+}
+
 } // namespace rpcrt4
 
 #include "rpcrt4_trampolines.h"
diff --git a/dll/rpcrt4.h b/dll/rpcrt4.h
index 56e6dba..ccb010d 100644
--- a/dll/rpcrt4.h
+++ b/dll/rpcrt4.h
@@ -33,6 +33,7 @@ RPC_STATUS WINAPI RpcBindingSetAuthInfoExW(RPC_BINDING_HANDLE binding, RPC_WSTR
 										   RPC_SECURITY_QOS *securityQos);
 RPC_STATUS WINAPI RpcBindingFree(GUEST_PTR *binding);
 RPC_STATUS WINAPI RpcStringFreeW(GUEST_PTR *string);
+RPC_STATUS WINAPI UuidCreate(GUID *uuid);
 #ifndef __x86_64__ // TODO
 CLIENT_CALL_RETURN CDECL_NO_CONV NdrClientCall2(PMIDL_STUB_DESC stubDescriptor, PFORMAT_STRING format, ...);
 #endif
